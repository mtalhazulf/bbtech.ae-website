SITE_URL=https://bbtech.ae

# SMTP (form emails - src/app/api/contact/route.js). A mailbox on bbtech.ae; see
# content-import/needs-client-input.md for exactly what to ask the client for.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false          # true for port 465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BB Tech <no-reply@bbtech.ae>"
MAIL_TO=info@bbtech.ae
MAIL_BCC=

# Cloudflare Turnstile (form spam protection). NEXT_PUBLIC_ is inlined at BUILD time
# (see the Dockerfile ARG/ENV); TURNSTILE_SECRET_KEY is RUNTIME-only, never baked in.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
